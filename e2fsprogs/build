prepare() {
  mkdir -p build
  cd build
}

configure() {
  ../configure \
    --prefix=/usr \
    --exec-prefix=/usr \
    --bindir=/usr/bin \
    --sbindir=/usr/bin \
    --libexecdir=/usr/lib \
    --sysconfdir=/etc \
    --sharedstatedir=/var/lib \
    --localstatedir=/var \
    --runstatedir=/run \
    --libdir=/usr/lib \
    --enable-symlink-install \
    --enable-relative-symlinks \
    --enable-symlink-build \
    --enable-elf-shlibs \
    --disable-bsd-shlibs \
    --enable-hardening \
    --disable-testio-debug \
    --disable-libuuid \
    --disable-libblkid \
    --disable-backtrace \
    --disable-debugfs \
    --disable-imager \
    --disable-defrag \
    --disable-fsck \
    --enable-e2initrd-helper \
    --disable-tls \
    --disable-uuidd \
    --disable-mmp \
    --disable-tdb \
    --disable-bmap-stats \
    --disable-nls \
    --disable-rpath \
    --disable-fuse2fs \
    --enable-lto \
    --without-libiconv-prefix \
    --without-libintl-prefix \
    --without-libarchive \
    --without-udev-rules-dir \
    --without-crond-dir \
    --without-systemd-unit-dir
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip
}

purge() {
  rm -fv \
    "$dir/usr/bin/chattr" \
    "$dir/usr/bin/lsattr"
}
