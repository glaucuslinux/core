build() {
  LDFLAGS_DYNLIB="$LDFLAGS" \
  make \
    -C lib \
    ZSTD_LEGACY_SUPPORT=0 \
    HASH='xxhsum -H2' \
    "lib$nom"

  CPPFLAGS='-DZSTD_NOBENCH -DZSTD_NODICT -DZSTD_NOTRACE -UZSTD_LEGACY_SUPPORT -DZSTD_LEGACY_SUPPORT=0' \
  make \
    -C programs \
    HAVE_THREAD=1 \
    HAVE_ZLIB=0 \
    HAVE_LZMA=0 \
    HAVE_LZ4=0 \
    BACKTRACE=0 \
    ZSTD_LEGACY_SUPPORT=0 \
    HASH='xxhsum -H2' \
    "$nom-dll"
}

package() {
  make \
    -C lib \
    DESTDIR="$dir" \
    prefix=/usr \
    exec_prefix=/usr \
    libdir=/usr/lib \
    PKGCONFIGDIR=/usr/lib/pkgconfig \
    install-pc \
    install-shared \
    install-includes

  mkdir -p "$dir/usr/bin"

  mv -f "programs/$nom" "$dir/usr/bin"
  ln -fs "$nom" "$dir/usr/bin/un$nom"
}
