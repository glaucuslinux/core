prepare() {
  autoreconf -vfis
}

configure() {
  set --

  if [ -n "${bootstrap-}" ]; then
    set -- \
        --build="$build" \
        --host="$host"
  fi

  glaucus-configure \
    "$@" \
    --disable-nls \
    --disable-rpath \
    --disable-load \
    --without-guile \
    --without-libiconv-prefix \
    --without-libintl-prefix
}

build() {
  "$nom"
}

package() {
  "$nom" \
    DESTDIR="$dir" \
    install-strip
}

purge() {
  rm -fRv "$dir/usr/include"
}
