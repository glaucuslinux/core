prepare() {
  autoreconf -vfis
}

configure() {
  set --

  if [ -n "${bootstrap-}" ]; then
    set -- \
        --build="$build" \
        --host="$host"
  fi

  glaucus-configure \
    "$@" \
    --disable-static \
    --enable-pic \
    --disable-symvers \
    --enable-jit \
    --disable-pcre2grep-callout \
    --disable-pcre2grep-callout-fork \
    --enable-pcre2test-libedit
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip
}

purge() {
  rm -fRv "$dir/usr/bin"
}
