build() {
  glaucus-muon \
    -Dalign-test=false \
    -Ddebug-level=0 \
    -Dfast-dec-loop=enabled \
    -Dossfuzz=false \
    -Dprograms=true \
    build
}

build() {
  samu \
    -C build
}

package() {
  DESTDIR="$dir" \
  muon \
    -C build \
    install
}
