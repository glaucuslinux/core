configure() {
  glaucus-cmake \
    -B build \
    -DBUILD_APPS=OFF \
    -DBUILD_STATIC_LIBS=OFF \
    -DCMAKE_POLICY_DEFAULT_CMP0219=OLD \
    -DDISABLE_EXTRA_LIBS=ON \
    -DDISABLE_JSON_POINTER=ON \
    -DDISABLE_WERROR=ON \
    -DENABLE_RDRAND=ON \
    -DENABLE_THREADING=ON
}

build() {
  make \
    -C build
}

package() {
  make \
    -C build \
    DESTDIR="$dir" \
    install/strip
}

purge() {
  rm -fRv "$dir/usr/lib/cmake"
}
