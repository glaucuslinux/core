prepare() {
  autoreconf -vfis
}

configure() {
  glaucus-configure \
    --enable-libgdbm-compat \
    --disable-static \
    --enable-pic \
    --disable-nls \
    --disable-rpath \
    --without-libiconv-prefix \
    --without-libintl-prefix
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip
}
