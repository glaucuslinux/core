configure() {
  glaucus-muon \
    -Ddwrite=disabled \
    -Dfontconfig=enabled \
    -Dfreetype=enabled \
    -Dpng=enabled \
    -Dquartz=disabled \
    -Dtee=disabled \
    -Dxcb=disabled \
    -Dxlib=disabled \
    -Dzlib=enabled \
    -Dtests=disabled \
    -Dlzo=disabled \
    -Dglib=disabled \
    -Dspectre=disabled \
    -Dsymbol-lookup=disabled \
    build
}

build() {
  samu \
    -C build
}

package() {
  DESTDIR="$dir" \
  muon \
    -C build \
    install
}

purge() {
  rm -fRv \
    "$dir/usr/bin/$nom-trace" \
    "$dir/usr/lib/$nom"
}
