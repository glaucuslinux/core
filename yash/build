prepare() {
  patch \
    -i "$core/$nom/patches/glaucus/0001-configure-$nom.patch" \
    -p 0
}

configure() {
  set --

  if [ -n "${bootstrap-}" ]; then
    set -- \
        --host="$host"
  fi

  ./configure \
    "$@" \
    --prefix=/usr \
    --exec-prefix=/usr \
    --bindir=/usr/bin \
    --disable-array \
    --disable-dirstack \
    --disable-double-bracket \
    --disable-nls \
    --disable-doc \
    --disable-socket \
    --with-term-lib=terminfo
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip

  ln -fs "$nom" "$dir/usr/bin/sh"
}
