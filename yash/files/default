# set
set +o posixly-correct

set -o brace-expand
set -o extended-glob
set -o hist-space
set -o le-no-conv-meta
set -o le-predict

set -u

set -o emacs

# bind
bindkey -e '\^[[1;5C' forward-semiword
bindkey -e '\^[[1;5D' backward-semiword

bindkey -e '\D' beginning-search-forward
bindkey -e '\U' beginning-search-backward

bindkey -e '\^L' clear-and-redraw-all

bindkey -e '\^H' backward-kill-semiword
bindkey -e '\^W' backward-kill-semiword

bindkey -e '\^[[3;5~' delete-semiword

# alias
alias grep='grep --color=auto'
alias ls='ls -F --color=auto'

# var
: "${ECHO_STYLE:=RAW}"
: "${EDITOR:=vi}"
: "${HOSTNAME:=$(uname -n)}" # do not fork on every source
: "${LANG:=C}"
: "${LOGNAME:=$(logname)}" # do not fork on every source
: "${PAGER:=less}"
: "${PATH:=/usr/bin}"
: "${TERM:=linux}"
: "${VISUAL:=$EDITOR}"

export EDITOR
export HOSTNAME
export LANG
export LOGNAME
export PAGER
export PATH
export TERM
export VISUAL

# hist
HISTFILE="$HOME/.yash_history"
HISTSIZE=100000

# mail
unset MAIL MAILCHECK MAILPATH

# ps
YASH_PS1='\fy.$LOGNAME\fd.@\fb.$HOSTNAME\fd. ${PWD##*/} \fr.$?\fd. \$ '
YASH_PS1P='\fci.'
YASH_PS1R='\fi.$(date "+%r")'
YASH_PS1S='\fo.'

PS1='$LOGNAME@$HOSTNAME ${PWD##*/} $? \$ '$PS1
