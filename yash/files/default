# set
set --brace-expand
set --emacs
set --extended-glob
set --hist-space
set --le-no-conv-meta
set --le-predict

set +o posixly-correct

set -u

# bind
bindkey -e '\^[[1;5C' forward-semiword
bindkey -e '\^[[1;5D' backward-semiword

bindkey -e '\D' beginning-search-forward
bindkey -e '\U' beginning-search-backward

bindkey -e '\^L' clear-and-redraw-all

bindkey -e '\^H' backward-kill-semiword
bindkey -e '\^W' backward-kill-semiword

bindkey -e '\^[[3;5~' delete-semiword

# trap
case $- in (*m*)
  trap - TSTP TTIN TTOU
esac

# env
: ${EDITOR:=vi} ${PAGER:=less} ${VISUAL:=$EDITOR}
: ${LOGNAME:=$(id -un)} ${HOSTNAME:=$(uname -n)}
: ${ECHO_STYLE:=RAW}

export PATH=/usr/bin
export TERM="${TERM:-linux}"
export LANG="${LANG:-C.UTF-8}"

# history
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/yash/history"

! [ -d "${HISTFILE%/*}" ] && mkdir -p "${HISTFILE%/*}"

HISTSIZE=100000

# mail
unset MAILCHECK

# shlvl
if [ "${_old_shlvl+set}" != set ]; then
  _old_shlvl=${SHLVL-}
fi
SHLVL=$((_old_shlvl+1)) 2>/dev/null || SHLVL=1
export SHLVL

# prompt
YASH_PS1='\fc.${LOGNAME}\fd.@\fy.${HOSTNAME%%.*}\fd. ${${${PWD:/~/\~}##*/}:-$PWD} ${{?:/0/}:+\\fr.$?\\fd. }\$ '
YASH_PS1P='\fi.'
YASH_PS1S='\fo.'

PS1='${LOGNAME}@${HOSTNAME%%.*} '$PS1

# alias
alias grep='grep --color=auto'
alias ls='ls -F --color=auto'
