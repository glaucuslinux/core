prepare() {
  autoreconf -vfis
}

configure() {
  set --

  if [ -n "${bootstrap-}" ]; then
    set -- \
        --build="$build" \
        --host="$host"
  fi

  CFLAGS="$CFLAGS -D__STDC_ISO_10646__" \
  LIBS='-lterminfo' \
  glaucus-configure \
    "$@" \
    --disable-static \
    --enable-pic \
    --disable-examples
}

build() {
  LIBS='-lterminfo' \
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip

  mkdir -p "$dir/etc"
  cp -fPp "$core/$nom/files/editrc" "$dir/etc"

  mkdir -p "$dir/usr/include/readline"
  for i in history readline tilde; do
    ln -fs ../editline/readline.h "$dir/usr/include/readline/$i.h"
  done

  ln -fs "$nom.so" "$dir/usr/lib/libhistory.so"
  ln -fs "$nom.so" "$dir/usr/lib/libreadline.so"

  ln -fs "$nom.pc" "$dir/usr/lib/pkgconfig/history.pc"
  ln -fs "$nom.pc" "$dir/usr/lib/pkgconfig/readline.pc"
}
