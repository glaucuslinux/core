prepare() {
  patch \
    -i "$core/$nom/patches/chimera/no-getgroups.patch" \
    -p 1
  patch \
    -i "$core/$nom/patches/chimera/no-printf.patch" \
    -p 1
}

package() {
  make \
    PREFIX=/usr \
    DESTDIR="$dir" \
    install
}
