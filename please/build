build() {
  make \
    CC="$CC" \
    CFLAGS="$CFLAGS" \
    LDLIBS="$LDFLAGS -lcrypt"
}

package() {
  mkdir -p \
    "$dir/etc" \
    "$dir/usr/bin"

  cp -fPp "$core/$nom/files/$nom.conf" "$dir/etc"
  chmod 400 "$dir/etc/$nom.conf"

  mv -f bin/pls "$dir/usr/bin/$nom"
  for i in doas pls sudo; do
    ln -fs "$nom" "$dir/usr/bin/$i"
  done
}
