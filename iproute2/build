configure() {
  ./configure \
    --libdir=/usr/lib \
    --libbpf_force=off \
    --prefix=/usr
}

build() {
  make
}

package() {
  make \
    SBINDIR=/usr/bin \
    DESTDIR="$dir" \
    install
}

purge() {
  rm -fRv \
    "$dir/usr/bin/ctstat" \
    "$dir/usr/bin/dcb" \
    "$dir/usr/bin/devlink" \
    "$dir/usr/bin/genl" \
    "$dir/usr/bin/ifstat" \
    "$dir/usr/bin/lnstat" \
    "$dir/usr/bin/netshaper" \
    "$dir/usr/bin/nstat" \
    "$dir/usr/bin/rdma" \
    "$dir/usr/bin/routel" \
    "$dir/usr/bin/rtacct" \
    "$dir/usr/bin/rtmon" \
    "$dir/usr/bin/rtstat" \
    "$dir/usr/bin/tipc" \
    "$dir/usr/bin/vdpa" \
    "$dir/usr/include" \
    "$dir/usr/share/bash-completion"
}
