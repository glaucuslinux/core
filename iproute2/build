configure() {
  ./configure \
    --libdir=/usr/lib \
    --libbpf_force=off \
    --prefix=/usr
}

build() {
  make \
    PREFIX=/usr \
    SBINDIR=/usr/bin \
    NETNS_RUN_DIR=/run/netns \
    HAVE_MNL=n
}

package() {
  make \
    PREFIX=/usr \
    SBINDIR=/usr/bin \
    NETNS_RUN_DIR=/run/netns \
    HAVE_MNL=n \
    DESTDIR="$dir" \
    install
}

purge() {
  rm -fRv \
    "$dir/usr/bin/ctstat" \
    "$dir/usr/bin/genl" \
    "$dir/usr/bin/ifstat" \
    "$dir/usr/bin/lnstat" \
    "$dir/usr/bin/nstat" \
    "$dir/usr/bin/routel" \
    "$dir/usr/bin/rtacct" \
    "$dir/usr/bin/rtmon" \
    "$dir/usr/bin/rtstat" \
    "$dir/usr/include" \
    "$dir/usr/share/bash-completion"
}
