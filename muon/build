prepare() {
  ./bootstrap.sh build-bootstrap

  "build-bootstrap/$nom-bootstrap" setup \
    -Dwrap_mode=nodownload \
    -Dlibcurl=disabled \
    -Dlibarchive=disabled \
    -Dlibpkgconf=disabled \
    -Dtracy=disabled \
    -Dnative_backtrace=disabled \
    -Dman-pages=disabled \
    -Ddocs=disabled \
    -Dmeson-docs=disabled \
    -Dmeson-tests=disabled \
    -Dwebsite=disabled \
    build-bootstrap

  "build-bootstrap/$nom-bootstrap" \
    -C build-bootstrap \
    samu
}

configure() {
  PATH="$tmp/$nom/build-bootstrap:$PATH" \
  "$core/$nom/files/glaucus-$nom" \
    -Dlibcurl=disabled \
    -Dlibarchive=disabled \
    -Dlibpkgconf=disabled \
    -Dtracy=disabled \
    -Dnative_backtrace=disabled \
    -Dman-pages=disabled \
    -Ddocs=disabled \
    -Dmeson-docs=disabled \
    -Dmeson-tests=disabled \
    -Dwebsite=disabled \
    build
}

build() {
  "build-bootstrap/$nom" \
    -C build \
    samu
}

package() {
  DESTDIR="$dir" \
  "build/$nom" \
    -C build \
    install

  cp -fPp \
    "$core/$nom/files/glaucus-meson" \
    "$core/$nom/files/glaucus-$nom" \
    "$core/$nom/files/samu" \
    "$dir/usr/bin"

  ln -fs "$nom" "$dir/usr/bin/meson"
  ln -fs samu "$dir/usr/bin/ninja"
}
