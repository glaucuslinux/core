prepare() {
  ./build/autogen.sh
}

configure() {
  set --

  if [ -n "${bootstrap-}" ]; then
    set -- \
        --build="$build" \
        --host="$host"
  fi

  glaucus-configure \
    "$@" \
    --disable-static \
    --enable-pic \
    --enable-bsdtar=shared \
    --disable-bsdcat \
    --disable-bsdcpio \
    --enable-bsdunzip=shared \
    --disable-rpath \
    --enable-posix-regex-lib=libc \
    --disable-xattr \
    --disable-acl \
    --without-libb2 \
    --without-iconv \
    --without-libiconv-prefix \
    --without-cng \
    --without-xml2 \
    --without-expat
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip

  # Compatibility symlinks
  ln -fs bsdtar "$dir/usr/bin/tar"
  ln -fs bsdunzip "$dir/usr/bin/unzip"
}
