prepare() {
  ./autogen.sh \
    --no-po4a
}

configure() {
  set --

  if [ -n "${bootstrap-}" ]; then
    set -- \
        --build="$build" \
        --host="$host"
  fi

  SKIP_WERROR_CHECK=yes \
  glaucus-configure \
    "$@" \
    --enable-encoders=lzma1,lzma2,delta,x86 \
    --enable-match-finders=hc3,hc4,bt4 \
    --disable-lzip-decoder \
    --disable-arm64-crc32 \
    --disable-loongarch-crc32 \
    --enable-threads=posix \
    --disable-xzdec \
    --disable-lzmadec \
    --disable-lzmainfo \
    --disable-lzma-links \
    --disable-scripts \
    --disable-doc \
    --disable-sandbox \
    --disable-static \
    --enable-pic \
    --disable-symbol-versions \
    --disable-nls \
    --disable-rpath \
    --enable-unaligned-access \
    --without-libiconv-prefix \
    --without-libintl-prefix

  patch \
    -i "$core/$nom/patches/alpine/0001-disable-rpath.patch" \
    -p 0
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip
}
