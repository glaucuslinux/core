prepare() {
  cd "$tmp/$nom/iwd-$ver"

  autoreconf -vfis
}

configure() {
  glaucus-configure \
    --enable-pic \
    --enable-pie \
    --disable-dbus \
    --disable-client \
    --disable-monitor \
    --disable-dbus-policy \
    --disable-systemd-service \
    --disable-manual-pages
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip

  mkdir -p "$dir/etc/iwd"
  cp -fPp "$core/$nom/files/main.conf" "$dir/etc/iwd"
}
