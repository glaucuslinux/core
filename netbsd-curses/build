build() {
  make \
    PREFIX=/usr \
    BINDIR=/usr/bin \
    LIBDIR=/usr/lib \
    all-dynamic
}

package() {
  make \
    PREFIX=/usr \
    BINDIR=/usr/bin \
    LIBDIR=/usr/lib \
    DESTDIR="$dir" \
    install-dynamic

  chmod 755 \
    "$dir/usr/lib/libcurses.so" \
    "$dir/usr/lib/libform.so" \
    "$dir/usr/lib/libmenu.so" \
    "$dir/usr/lib/libpanel.so" \
    "$dir/usr/lib/libterminfo.so"
}
