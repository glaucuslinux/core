build() {
  make \
    PREFIX=/usr \
    BINDIR=/usr/bin \
    LIBDIR=/usr/lib \
    CROSSCOMPILING=1 \
    all-dynamic
}

package() {
  make \
    PREFIX=/usr \
    BINDIR=/usr/bin \
    LIBDIR=/usr/lib \
    DESTDIR="$dir" \
    install-dynamic

  chmod 755 "$dir/usr/lib/lib"*.so
}
