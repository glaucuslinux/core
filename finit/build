prepare() {
  autoreconf -vfis
}

configure() {
  glaucus-configure \
    --enable-pic \
    --enable-auto-reload \
    --enable-fastboot \
    --disable-logrotate \
    --disable-dbus \
    --disable-doc \
    --disable-contrib \
    --disable-rescue \
    --disable-all-plugins \
    --enable-rtc-plugin \
    --enable-urandom-plugin \
    --without-bash-completion-dir \
    --with-heading="$PRETTY_NAME" \
    --without-rc-local \
    --without-sulogin \
    --without-watchdog \
    --with-plugin-path="/usr/lib/$nom/plugins"
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip
}

purge() {
  rm -fRv \
    "$dir/usr/include" \
    "$dir/usr/share"
}
