prepare() {
  autoreconf -vfis
}

configure() {
  ac_cv_lib_bz2_BZ2_bzDecompressInit=no \
  glaucus-configure \
    --disable-static \
    --enable-pic \
    --disable-nls \
    --disable-rpath \
    --disable-compress \
    --disable-vlock \
    --disable-tests \
    --disable-memcheck \
    --without-libiconv-prefix \
    --without-libintl-prefix \
    --without-gcov \
    --without-zlib \
    --without-bzip2 \
    --without-lzma \
    --without-zstd
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip
}

purge() {
  rm -fRv \
    "$dir/usr/bin/loadunimap" \
    "$dir/usr/bin/mapscrn" \
    "$dir/usr/bin/psf"* \
    "$dir/usr/bin/resizecons" \
    "$dir/usr/share/consolefonts/partialfonts" \
    "$dir/usr/share/consoletrans" \
    "$dir/usr/share/keymaps/amiga" \
    "$dir/usr/share/keymaps/atari" \
    "$dir/usr/share/keymaps/mac" \
    "$dir/usr/share/keymaps/pine" \
    "$dir/usr/share/keymaps/ppc" \
    "$dir/usr/share/keymaps/sun" \
    "$dir/usr/share/unimaps"

  find "$dir/usr/share" -name 'README*' -type f -delete
}
