prepare() {
  ./buildconf.sh
}

configure() {
  set --

  if [ -n "${bootstrap-}" ]; then
    set -- \
        --build="$build" \
        --host="$host"
  fi

  glaucus-configure \
    "$@" \
    --disable-static \
    --enable-pic \
    --without-xmlwf \
    --without-examples \
    --without-tests \
    --without-arc4random \
    --without-arc4random-buf \
    --without-getentropy \
    --with-getrandom \
    --without-sys-getrandom \
    --without-docbook
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip
}
