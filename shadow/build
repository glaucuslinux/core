prepare() {
  patch \
    -i "$core/$nom/patches/glaucus/0001-customize-login-defaults.patch" \
    -p 0
  patch \
    -i "$core/$nom/patches/glaucus/0002-customize-useradd-defaults.patch" \
    -p 0

  autoreconf -vfis
}

configure() {
  if [ -n "${bootstrap-}" ]; then
    set -- \
        --build="$build" \
        --host="$host"
  else
    set -- \
        --with-fcaps
  fi

  glaucus-configure \
    "$@" \
    --disable-static \
    --enable-pic \
    --enable-lastlog \
    --disable-logind \
    --disable-nls \
    --disable-rpath \
    --without-audit \
    --without-libpam \
    --without-selinux \
    --without-acl \
    --without-attr \
    --without-tcb \
    --with-yescrypt \
    --without-nscd \
    --without-su \
    --without-libbsd
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip
}
