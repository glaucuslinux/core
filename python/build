prepare() {
  cd "$tmp/$nom/Python-$ver"

  patch \
    -i "$core/$nom/patches/alpine/musl-find_library.patch" \
    -p 1
  patch \
    -i "$core/$nom/patches/glaucus/0001-libressl-compat.patch" \
    -p 0
  patch \
    -i "$core/$nom/patches/openbsd/Modules__hashopenssl_c.patch" \
    -p 0
}

configure() {
  glaucus-configure \
    --enable-shared \
    --disable-gil \
    --enable-safety \
    --enable-slower-safety \
    --enable-ipv6 \
    --disable-test-modules \
    --with-pkg-config \
    --without-static-libpython \
    --with-lto=thin \
    --with-system-expat \
    --with-system-libmpdec \
    --without-doc-strings \
    --with-mimalloc \
    --without-pymalloc \
    --without-readline \
    --without-computed-gotos \
    --with-tail-call-interp \
    --without-remote-debug \
    --without-ensurepip \
    --with-ssl-default-suites=openssl
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    altbininstall \
    libinstall \
    sharedinstall
}

purge() {
  rm -fRv \
    "$dir/usr/lib/${nom}3.14t/ensurepip" \
    "$dir/usr/lib/${nom}3.14t/idlelib" \
    "$dir/usr/lib/${nom}3.14t/pydoc"* \
    "$dir/usr/lib/${nom}3.14t/tkinter" \
    "$dir/usr/lib/${nom}3.14t/turtle"*
}
