configure() {
  set --

  if [ -n "${bootstrap-}" ]; then
    set -- \
        --build="$build" \
        --host="$host"
  fi

  glaucus-configure \
    "$@"
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install

  ln -fs rlibtool "$dir/usr/bin/libtool"
  ln -fs "${nom}ize" "$dir/usr/bin/libtoolize"

  mkdir -p "$dir/usr/share/aclocal"

  ln -fs "../$nom/$nom.m4" "$dir/usr/share/aclocal"
  ln -fs "../$nom/$nom.m4" "$dir/usr/share/aclocal/libtool.m4"
}

purge() {
  rm -fv \
    "$dir/usr/bin/clibtool"* \
    "$dir/usr/bin/dclibtool"* \
    "$dir/usr/bin/dlibtool"* \
    "$dir/usr/bin/rclibtool"* \
    "$dir/usr/bin/rdclibtool"* \
    "$dir/usr/bin/rdlibtool"*
}
