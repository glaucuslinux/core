prepare() {
  touch \
    "aclocal.$nom" \
    Makefile.in
}

configure() {
  set --

  if [ -n "${bootstrap-}" ]; then
    set -- \
        --build="$build" \
        --host="$host"
  fi

  glaucus-configure \
    "$@" \
    --enable-threads=posix \
    --disable-assert \
    --disable-rpath \
    --disable-nls \
    --without-libsigsegv \
    --without-gnulib-prefix \
    --without-libiconv-prefix \
    --without-libintl-prefix
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip
}
