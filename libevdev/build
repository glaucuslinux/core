prepare() {
  cd "$tmp/$nom/$nom-$nom-$ver"
}

configure() {
  glaucus-muon \
    -Dtests=disabled \
    -Dtools=disabled \
    -Ddocumentation=disabled \
    build
}

build() {
  samu \
    -C build
}

package() {
  DESTDIR="$dir" \
  muon \
    -C build \
    install
}
