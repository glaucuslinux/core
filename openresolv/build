configure() {
  ./configure \
    --os=linux \
    --disable-debug \
    --prefix=/usr \
    --sysconfdir=/etc \
    --bindir=/usr/bin \
    --libexecdir=/usr/lib/resolvconf \
    --localstatedir=/var \
    --rundir=/run \
    --libdir=/usr/lib
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install
}

purge() {
  rm -fRv \
    "$dir/usr/lib/resolvconf/dnsmasq" \
    "$dir/usr/lib/resolvconf/libc.d" \
    "$dir/usr/lib/resolvconf/named" \
    "$dir/usr/lib/resolvconf/pdnsd" \
    "$dir/usr/lib/resolvconf/pdns_recursor" \
    "$dir/usr/lib/resolvconf/resolvectl" \
    "$dir/usr/lib/resolvconf/systemd-resolved" \
    "$dir/usr/lib/resolvconf/unbound"
}
