prepare() {
  patch \
    -i "$core/$nom/patches/upstream/0001-PR-579-net147-Fix-stack-overrun.patch" \
    -p 1
  patch \
    -i "$core/$nom/patches/upstream/0002-PR-571-jschleus-Some-zip-files-are-misclassified-as-data.patch" \
    -p 1

  autoreconf -vfis
}

configure() {
  set --

  if [ -n "${bootstrap-}" ]; then
    set -- \
        --build="$build" \
        --host="$host"
  fi

  glaucus-configure \
    "$@" \
    --disable-zlib \
    --disable-bzlib \
    --disable-xzlib \
    --disable-zstdlib \
    --disable-lzlib \
    --disable-lrziplib \
    --disable-libseccomp \
    --enable-pic
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    install-strip
}

purge() {
  rm -fRv \
    "$dir/usr/include" \
    "$dir/usr/lib/pkgconfig"
}
