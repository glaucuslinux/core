configure() {
  ./Configure \
    -des \
    -Accflags='-DNO_MATHOMS -DNO_TAINT_SUPPORT' \
    -Dcc="$CC" \
    -Dcf_by="$PRETTY_NAME" \
    -Dd_sockaddr_in6 \
    -Dinc_version_list=none \
    -Dinstallusrbinperl \
    -Dnoextensions="Archive/Tar Compress/Raw/Bzip2 Compress/Raw/Zlib DB_File GDBM_File IO/Compress IO/Uncompress IO/Zlib NDBM_File ODBM_File SDBM_File XS/APItest XS/Typemap" \
    -Doptimize="$CFLAGS" \
    -Dpager='/usr/bin/less -is' \
    -Dprefix=/usr \
    -Duseshrplib \
    -Dusethreads \
    -Dvendorprefix=/usr \
    -UDEBUGGING \
    -Uusenm
}

build() {
  make
}

package() {
  make \
    DESTDIR="$dir" \
    INSTALLFLAGS='-s -f -o -p' \
    "install.$nom"
}

purge() {
  rm -fv \
    "$dir/usr/bin/corelist" \
    "$dir/usr/bin/cpan" \
    "$dir/usr/bin/enc2xs" \
    "$dir/usr/bin/encguess" \
    "$dir/usr/bin/h2ph" \
    "$dir/usr/bin/h2xs" \
    "$dir/usr/bin/instmodsh" \
    "$dir/usr/bin/json_pp" \
    "$dir/usr/bin/libnetcfg" \
    "$dir/usr/bin/perl5.42.0" \
    "$dir/usr/bin/perlbug" \
    "$dir/usr/bin/perldoc" \
    "$dir/usr/bin/perlivp" \
    "$dir/usr/bin/perlthanks" \
    "$dir/usr/bin/piconv" \
    "$dir/usr/bin/pl2pm" \
    "$dir/usr/bin/pod2html" \
    "$dir/usr/bin/pod2man" \
    "$dir/usr/bin/pod2text" \
    "$dir/usr/bin/pod2usage" \
    "$dir/usr/bin/podchecker" \
    "$dir/usr/bin/prove" \
    "$dir/usr/bin/ptar" \
    "$dir/usr/bin/ptardiff" \
    "$dir/usr/bin/ptargrep" \
    "$dir/usr/bin/shasum" \
    "$dir/usr/bin/splain" \
    "$dir/usr/bin/streamzip" \
    "$dir/usr/bin/xsubpp" \
    "$dir/usr/bin/zipdetails"

    find "$dir" \( -name '*.e2x' -o -name '*.pod' \) -type f -delete
}
